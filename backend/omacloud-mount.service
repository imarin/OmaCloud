[Unit]
Description=OmaCloud: monta Google Drive en ~/Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/Drive
ExecStart=%h/.local/bin/rclone mount OmaCloud: %h/Drive --vfs-cache-mode writes --dir-cache-time 5m
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

#!/usr/bin/env bash
# OmaCloud: sincroniza pares local <-> Drive y publica estado agregado.
# Pares en ~/.config/omacloud/pairs, una línea por par:
#   REMOTE_SPEC | LOCAL_DIR
# Ejemplos:
#   OmaCloud:Proyectos | ~/Drive-sel/Proyectos
#   OmaCloud,root_folder_id=<ID>: | ~/MacBookPro   (carpetas de "Computadoras": ID de la URL)
# Sin archivo: Drive completo <-> réplica (comportamiento original).
# Cada par nuevo corre --resync una sola vez (marcador en STATE_DIR).
# Estado agregado (contrato con el widget, ADR-002): $STATE_DIR/status.json
#   {"status":"syncing|ok|error","last_sync":"...","last_error":"...","updated":"..."}
set -u

# Secretos y overrides locales (fuera del repo, nunca se commitean).
# shellcheck disable=SC1091
[ -f "$HOME/.config/omacloud/.env" ] && . "$HOME/.config/omacloud/.env"

REMOTE="${OMACLOUD_REMOTE:-OmaCloud:}"
REPLICA="${OMACLOUD_REPLICA:-${XDG_DATA_HOME:-$HOME/.local/share}/omacloud/replica}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omacloud"
PAIRS_FILE="$HOME/.config/omacloud/pairs"
STATUS="$STATE_DIR/status.json"
LOG="$STATE_DIR/bisync.log"

mkdir -p "$REPLICA" "$STATE_DIR"

prev_sync="$(grep -o '"last_sync":"[^"]*"' "$STATUS" 2>/dev/null | cut -d'"' -f4)"
prev_status="$(grep -o '"status":"[^"]*"' "$STATUS" 2>/dev/null | cut -d'"' -f4)"
LAST_SYNC="${prev_sync:-never}"

if [[ "${LC_ALL:-${LANG:-en}}" =~ ^es ]]; then
  N_TITLE="OmaCloud"
  N_ERR="Error de sincronización"
  N_OK="Sincronización restablecida"
else
  N_TITLE="OmaCloud"
  N_ERR="Sync error"
  N_OK="Sync recovered"
fi

notify() { # $1=urgency, $2=text
  command -v notify-send >/dev/null || return 0
  notify-send -a "$N_TITLE" -u "$1" "$N_TITLE" "$2" || true
}

write_status() { # $1=status, $2=last_error
  local err="${2//\"/}" # sanea comillas para no romper el JSON
  printf '{"status":"%s","last_sync":"%s","last_error":"%s","updated":"%s"}\n' \
    "$1" "$LAST_SYNC" "$err" "$(date -u +%FT%TZ)" > "$STATUS.tmp" \
    && mv "$STATUS.tmp" "$STATUS"
}

# Carga pares: arreglo de "remote|local".
pairs=()
if [ -f "$PAIRS_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}" # trim izq
    [[ -z "$line" || "$line" == \#* || "$line" != *"|"* ]] && continue
    pairs+=("$line")
  done < "$PAIRS_FILE"
fi
[ "${#pairs[@]}" -eq 0 ] && pairs=("$REMOTE | $REPLICA")

sync_pair() { # $1=remote, $2=ldir -> 0 ok, 1 error (imprime error por stdout)
  local remote="$1" ldir="$2"
  local tag
  tag="$(basename "$ldir")"
  mkdir -p "$ldir"
  local marker="$STATE_DIR/resynced_$(printf '%s|%s' "$remote" "$ldir" | sha1sum | cut -d' ' -f1)"
  local flags=()
  if [ ! -f "$marker" ]; then
    flags+=(--resync)
  fi
  if rclone bisync "$ldir" "$remote" "${flags[@]}" --log-file "$LOG" --log-file-max-age 7d >>"$LOG" 2>&1; then
    touch "$marker"
    return 0
  fi
  local err
  err="$(grep -i -m1 -E 'error|abort|fail' "$LOG" | tail -c 250)"
  printf '[%s] %s' "$tag" "$err"
  return 1
}

write_status "syncing" ""

failed=""
for p in "${pairs[@]}"; do
  remote="${p%%|*}"; ldir="${p#*|}"
  remote="${remote%"${remote##*[![:space:]]}"}" # trim der
  ldir="${ldir#"${ldir%%[![:space:]]*}"}"   # trim izq
  ldir="${ldir/#\~/$HOME}"                   # expande ~
  if [ -z "$remote" ] || [ -z "$ldir" ]; then
    failed="[par inválido] $p"
    break
  fi
  err="$(sync_pair "$remote" "$ldir")" || { failed="$err"; break; }
done

if [ -z "$failed" ]; then
  LAST_SYNC="$(date -u +%FT%TZ)"
  write_status "ok" ""
  # Avisa solo al recuperarse (evita spam cada ciclo).
  [ "${prev_status:-}" = "error" ] && notify normal "$N_OK"
else
  write_status "error" "$failed"
  # Avisa solo al primer fallo; los siguientes ya están notificados.
  [ "${prev_status:-}" = "error" ] || notify critical "$N_ERR" "$failed"
  exit 1
fi
